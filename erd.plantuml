@startuml

' ========== Entities ==========
entity "User" {
  *id: int <<PK>>
  --
  name: string
  email: string
  identity_code: string <<unique>>
  password: string
  role: enum {student, lecturer, admin}
}

entity "RegularClass" {
  *id: int <<PK>>
  --
  class_code: string <<unique>>
  name: string
  slug: string <<unique>>
}

entity "Course" {
  *id: int <<PK>>
  --
  course_code: string <<unique>>
  name: string
}

entity "CourseClass" {
  *id: int <<PK>>
  --
  course_class_code: string <<unique>>
  course_class_join_code: string <<unique>>
  name: string
  description: string
  active: bool
  start_date: datetime
  slug: string <<unique>>
}

entity "Exercise" {
  *id: int <<PK>>
  --
  title: string
  description: string
  test_cases: json
  is_free: bool
}

entity "Submission" {
  *id: int <<PK>>
  --
  source_code: string
  language: string
  status: string
  execution_time: double
  memory_used: int
  output: string
  judge0_token: string
}

entity "Language" {
  *id: int <<PK>>
  --
  name: string <<unique>>
  judge_language_id: int
}

entity "Topic" {
  *id: int <<PK>>
  --
  name: string <<unique>>
}

entity "Conversation" {
  *id: int <<PK>>
  --
  name: string
  slug: string <<unique>>
}

entity "Message" {
  *id: int <<PK>>
  --
  content: string
}

' ========== Relationships with Diamond Notation ==========

' User - RegularClass: Một User thuộc về tối đa 1 RegularClass
diamond "attends"
User ||--> "attends"
"attends" }o--> RegularClass

' User - CourseClass: Nhiều-nhiều
diamond "enrolled_in"
User }o--> "enrolled_in"
"enrolled_in" }o--> CourseClass

' Course - CourseClass: Một Course có nhiều CourseClass
diamond "contains"
Course ||--> "contains"
"contains" }o--> CourseClass

' RegularClass - CourseClass: Một RegularClass có nhiều CourseClass
diamond "assigned_to"
RegularClass ||--> "assigned_to"
"assigned_to" }o--> CourseClass

' Course - Exercise: Nhiều-nhiều
diamond "includes"
Course }o--> "includes"
"includes" }o--> Exercise

' CourseClass - Exercise: Nhiều-nhiều
diamond "assigns"
CourseClass }o--> "assigns"
"assigns" }o--> Exercise

' Exercise - Language: Nhiều-nhiều
diamond "supported_by"
Exercise }o--> "supported_by"
"supported_by" }o--> Language

' Exercise - Topic: Nhiều-nhiều
diamond "tagged_with"
Exercise }o--> "tagged_with"
"tagged_with" }o--> Topic

' User - Submission: Một User nộp nhiều Submission
diamond "submits"
User ||--> "submits"
"submits" }o--> Submission

' Exercise - Submission: Một Exercise có nhiều Submission
diamond "evaluated_by"
Exercise ||--> "evaluated_by"
"evaluated_by" }o--> Submission

' CourseClass - Conversation: Một CourseClass có một Conversation
diamond "has"
CourseClass ||--> "has"
"has" ||--> Conversation

' Conversation - Message: Một Conversation có nhiều Message
diamond "contains_messages"
Conversation ||--> "contains_messages"
"contains_messages" }o--> Message

' User - Message: Một User gửi nhiều Message
diamond "sends"
User ||--> "sends"
"sends" }o--> Message

@enduml